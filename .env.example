# FIRM — Environment Configuration Template
# Copy this file to .env.local for local testing.
# Never commit real API keys or credentials to version control.

# 1. Site & Domain Configuration
# Optional: Set an explicit public URL for production or preview builds.
# If unset, builds fall back to Netlify's deployment URL or http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Email Delivery Provider (Server-Only)
# Reserve RESEND_API_KEY when commercial email dispatch is configured.
# If unset, the backend honestly returns 503 SERVICE_UNCONFIGURED and prevents false success states.
# RESEND_API_KEY=re_1234567890abcdef

# 3. Notification Routing (Server-Only)
# Official inbox where client project briefings will be delivered once live.
# NOTIFICATION_RECIPIENT_EMAIL=partners@your-company.com

# 4. Verified Sender Identity (Server-Only)
# Verified sending domain configured within your email delivery provider.
# NOTIFICATION_FROM_EMAIL=Briefing Gateway <briefings@your-company.com>
